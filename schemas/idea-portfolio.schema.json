{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/idea-portfolio.schema.json",
  "title": "Idea Portfolio",
  "type": "object",
  "required": [
    "brief_summary",
    "mode",
    "candidates",
    "warnings"
  ],
  "properties": {
    "brief_summary": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "standard",
        "balanced",
        "tail",
        "stratified",
        "multi"
      ]
    },
    "tau": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "strata": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "vs-candidate.schema.json"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}