{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/brief.schema.json",
  "title": "Idea Diversity Brief",
  "type": "object",
  "required": [
    "domain",
    "problem",
    "desired_effect"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "target_users": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "current_solution": {
      "type": "string",
      "default": ""
    },
    "pain_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "excluded_approaches": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "available_assets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "desired_effect": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string",
      "default": ""
    }
  },
  "additionalProperties": false
}